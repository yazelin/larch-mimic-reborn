<!--
  《轉生成寶箱怪的我》標題畫面（Larch settings.customInterfaces.title），方向 B「黃昏軟糖」（2026-11-10 作者選定）。
  底圖是標題主視覺（titleCoverImage，2D 手繪版），左上的天空留給書名；按鈕是一排半透明的軟糖泡泡。
  標題配樂用 <audio data-larch-asset> 掛媒體庫的 bgm-title，播放器依靜音狀態控制。
-->
<style>
@import url("https://fonts.googleapis.com/css2?family=Huninn&display=swap");
:root { color-scheme: light; --glass: rgba(255,246,252,.78); --ink: #4a3560; --pink: #ff8fb1; --pink-d: #d9688c; --lav: #b49ae6; --lav-d: #7a56aa; }
* { box-sizing: border-box; }
html, body { margin: 0; height: 100%; background: #b9a3d6; }
.cover { position: relative; min-height: 100dvh; overflow: hidden; font-family: "Huninn", "Noto Sans TC", sans-serif; color: var(--ink); }
.larch-project-font body .cover, .larch-project-font body .cover * { font-family: "Huninn", "Noto Sans TC", sans-serif !important; }
.art { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 60% 60%; pointer-events: none; }
.sky { position: absolute; inset: 0; pointer-events: none; background: radial-gradient(60% 55% at 18% 18%, rgba(255,240,250,.45), rgba(255,240,250,0) 70%); }
.content { position: absolute; left: 6vw; top: 8vh; display: grid; gap: 3.2vh; justify-items: start; }
h1 { margin: 0; line-height: 1.08; font-weight: 400; font-size: clamp(40px, 6.4vw, 104px); color: #fff; letter-spacing: .04em;
  text-shadow: 0 .06em 0 var(--pink), 0 .12em 0 var(--pink-d), 0 .2em .3em rgba(122,86,170,.45); }
h1 .s { display: block; font-size: .62em; letter-spacing: .12em; }
h1 .eyes { display: inline-flex; gap: .14em; vertical-align: .12em; margin-left: .2em; padding: .08em .18em; border-radius: .2em; background: rgba(74,53,96,.85); }
h1 .eyes i { width: .2em; height: .2em; border-radius: 50%; background: #ffe9a8; display: block; animation: blink 5s infinite; }
@keyframes blink { 0%, 92%, 100% { transform: scaleY(1); } 95% { transform: scaleY(.1); } }
nav { display: flex; flex-wrap: wrap; gap: 12px; padding: 10px; border-radius: 999px; background: var(--glass);
  box-shadow: 0 6px 0 rgba(122,86,170,.35), inset 0 0 0 3px #fff; backdrop-filter: blur(6px); }
button { font: inherit; font-size: clamp(16px, 1.35vw, 22px); letter-spacing: .12em; color: var(--ink); background: #fff; border: 0; border-radius: 999px;
  padding: .55em 1.5em; cursor: pointer; box-shadow: 0 4px 0 rgba(122,86,170,.25); transition: transform .15s, background .2s, color .2s, box-shadow .15s; }
button[data-larch-action="start"] { background: var(--pink); color: #fff; box-shadow: 0 4px 0 var(--pink-d); }
button:hover, button:focus-visible { transform: translateY(-2px); background: var(--lav); color: #fff; box-shadow: 0 6px 0 var(--lav-d); outline: none; }
button[data-larch-action="start"]:hover, button[data-larch-action="start"]:focus-visible { background: #ff7aa2; box-shadow: 0 6px 0 var(--pink-d); }
button:focus-visible { outline: 3px solid #fff; outline-offset: 2px; }
button:active { transform: translateY(2px); box-shadow: 0 1px 0 rgba(122,86,170,.3); }
button:disabled { opacity: .45; cursor: default; transform: none; }
button[hidden] { display: none; }
.bubbles i { position: absolute; bottom: -40px; width: var(--d); height: var(--d); left: var(--x); border-radius: 50%; pointer-events: none;
  background: radial-gradient(circle at 30% 30%, rgba(255,255,255,.9), rgba(255,255,255,.15) 45%, rgba(255,255,255,.05) 70%); box-shadow: inset 0 0 0 1px rgba(255,255,255,.6);
  animation: rise var(--t) linear infinite; animation-delay: var(--w); }
@keyframes rise { to { transform: translate(var(--dx), -110vh); } }
@media (max-width: 720px), (orientation: portrait) {
  .art { object-position: 66% 50%; }
  .content { left: 6vw; right: 6vw; top: 6vh; }
  h1 { font-size: clamp(34px, 11vw, 64px); }
  nav { position: fixed; left: 6vw; right: 6vw; bottom: 6vh; justify-content: center; }
}
@media (prefers-reduced-motion: reduce) { .bubbles { display: none; } h1 .eyes i { animation: none; } button { transition: none; } }
</style>
<main class="cover">
  <img class="art" data-larch-slot="cover" alt="">
  <div class="sky"></div>
  <div class="bubbles" aria-hidden="true">
    <i style="--x:12%;--d:18px;--t:16s;--w:-2s;--dx:20px"></i><i style="--x:34%;--d:10px;--t:12s;--w:-7s;--dx:-14px"></i>
    <i style="--x:58%;--d:24px;--t:19s;--w:-11s;--dx:30px"></i><i style="--x:73%;--d:12px;--t:14s;--w:-4s;--dx:-20px"></i>
    <i style="--x:88%;--d:16px;--t:17s;--w:-9s;--dx:12px"></i>
  </div>
  <div class="content">
    <h1 aria-label="轉生成寶箱怪的我"><span class="s">轉生成</span>寶箱怪的我<span class="eyes" aria-hidden="true"><i></i><i></i></span></h1>
    <nav aria-label="遊戲選單">
      <button data-larch-action="start">開始遊戲</button>
      <button data-larch-action="continue">繼續</button>
      <button data-larch-action="gallery">CG 收藏</button>
    </nav>
  </div>
  <audio data-larch-asset="media:168aaa82-4134-4f9d-8329-32487cb60492" autoplay loop></audio>
</main>
