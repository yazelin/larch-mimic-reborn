  "secs": 5.69
 },
 {
  "shot": 19,
  "idx": 2,
  "role": "箱爺爺",
  "text": "我第一次照這口井的時候，還以為自己是一個便當盒。",
  "say": "我第一次照這口井的時候，還以為自己是一個便當盒。",
