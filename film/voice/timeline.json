  "secs": 4.93
 },
 {
  "shot": 7,
  "idx": 4,
  "role": "寶箱怪",
  "text": "他們走到市集後面，把兩個睡著的族人撬開，拿走了大家寄放的東西。",
  "say": "他們走到市集後面，把兩個睡著的族人撬開，拿走了大家寄放的東西。",
