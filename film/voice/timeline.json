[
 {
  "shot": 1,
  "idx": 0,
  "role": "旁白",
  "text": "寶箱怪，住在這座島上的一種箱子。外表跟普通的寶箱一模一樣。",
  "say": "寶箱怪，住在這座島上的一種箱子。外表跟普通的寶箱一模一樣。",
  "inner": false,
  "emotion": "calm",
  "voice": "Chinese (Mandarin)_Lyrical_Voice",
  "file": "01_00_0ad979.mp3",
  "secs": 5.87
 },
 {
  "shot": 1,
  "idx": 1,
  "role": "旁白",
  "text": "蓋子是寶箱怪的嘴巴，也是腳。蓋子一開一闔，身體就往前蹦一下。",
  "say": "蓋子是寶箱怪的嘴巴，也是腳。蓋子一開一闔，身體就往前蹦一下。",
  "inner": false,
  "emotion": "calm",
  "voice": "Chinese (Mandarin)_Lyrical_Voice",
  "file": "01_01_06bef5.mp3",
  "secs": 6.52
 },
 {
  "shot": 1,
  "idx": 2,
  "role": "旁白",
  "text": "眼睛長在蓋子和箱身之間的縫裡。蓋子一闔緊，眼睛就藏起來了。",
  "say": "眼睛長在蓋子和箱身之間的縫裡。蓋子一闔緊，眼睛就藏起來了。",
  "inner": false,
  "emotion": "calm",
  "voice": "Chinese (Mandarin)_Lyrical_Voice",
  "file": "01_02_a27d73.mp3",
  "secs": 5.65
 },
 {
  "shot": 1,
  "idx": 3,
  "role": "旁白",
  "text": "眼睛後面黑黑的，看不到底。吃進去的果子、青蛙，會在這裡慢慢消化掉。",
  "say": "眼睛後面黑黑的，看不到底。吃進去的果子、青蛙，會在這裡慢慢消化掉。",
  "inner": false,
  "emotion": "calm",
  "voice": "Chinese (Mandarin)_Lyrical_Voice",
  "file": "01_03_6efb95.mp3",
  "secs": 6.98
 },
 {
  "shot": 1,
  "idx": 4,
  "role": "旁白",
  "text": "別人交給寶箱怪保管的東西，寶箱怪不會消化，會一直收好。只有放東西的那一家人來了，寶箱怪才會自己打開蓋子，把東西還給他們。",
  "say": "別人交給寶箱怪保管的東西，寶箱怪不會消化，會一直收好。只有放東西的那一家人來了，寶箱怪才會自己打開蓋子，把東西還給他們。",
  "inner": false,
  "emotion": "calm",
  "voice": "Chinese (Mandarin)_Lyrical_Voice",
  "file": "01_04_07193c.mp3",
  "secs": 12.31
 },
 {
  "shot": 1,
  "idx": 5,
  "role": "旁白",
  "text": "寶箱怪大部分的時間都在睡覺。睡著的時候幾乎不用吃東西，一整年只要幾顆蘋果就夠了。",
  "say": "寶箱怪大部分的時間都在睡覺。睡著的時候幾乎不用吃東西，一整年只要幾顆蘋果就夠了。",
  "inner": false,
  "emotion": "calm",
  "voice": "Chinese (Mandarin)_Lyrical_Voice",
  "file": "01_05_0de8f8.mp3",
  "secs": 8.21
 },
 {
  "shot": 2,
  "idx": 0,
  "role": "旁白",
  "text": "寶箱怪是怎麼來的？島上的老人說，一個箱子被人好好用了一百年，就會醒過來。",
  "say": "寶箱怪是怎麼來的？島上的老人說，一個箱子被人好好用了一百年，就會醒過來。",
  "inner": false,
  "emotion": "calm",
  "voice": "Chinese (Mandarin)_Lyrical_Voice",
  "file": "02_00_6aaf8b.mp3",
  "secs": 7.09
 },
 {
  "shot": 2,
  "idx": 1,
  "role": "旁白",
  "text": "島上的人一直把重要的東西放在箱子裡。所以醒過來的寶箱怪，也一直替大家保管這些東西。",
  "say": "島上的人一直把重要的東西放在箱子裡。所以醒過來的寶箱怪，也一直替大家保管這些東西。",
  "inner": false,
  "emotion": "calm",
  "voice": "Chinese (Mandarin)_Lyrical_Voice",
  "file": "02_01_7f44ae.mp3",
  "secs": 8.93
 },
 {
  "shot": 2,
  "idx": 2,
  "role": "旁白",
  "text": "睡著的寶箱怪，看起來就是一個普通的寶箱。",
  "say": "睡著的寶箱怪，看起來就是一個普通的寶箱。",
  "inner": false,
  "emotion": "calm",
  "voice": "Chinese (Mandarin)_Lyrical_Voice",
  "file": "02_02_636458.mp3",
  "secs": 3.67
 },
 {
  "shot": 3,
  "idx": 0,
  "role": "寶箱怪",
  "text": "我從來沒想過，轉生成寶箱怪這種事，會發生在我身上。",
  "say": "我從來沒想過，轉生成寶箱怪這種事，會發生在我身上。",
  "inner": false,
  "emotion": "surprised",
  "voice": "Chinese (Mandarin)_Sincere_Adult",
  "file": "03_00_7d1e93.mp3",
  "secs": 5.11
 },
 {
  "shot": 4,
  "idx": 0,
  "role": "寶箱怪",
  "text": "醒來的第一天，我想站起來，才發現自己沒有腳。",
  "say": "醒來的第一天，我想站起來，才發現自己沒有腳。",
  "inner": false,
  "emotion": "surprised",
  "voice": "Chinese (Mandarin)_Sincere_Adult",
  "file": "04_00_d3573d.mp3",
  "secs": 4.14
 },
 {
  "shot": 4,
  "idx": 1,
  "role": "寶箱怪",
  "text": "能動的只有蓋子。我試了一整個早上，才學會一開一闔往前蹦。",
  "say": "能動的只有蓋子。我試了一整個早上，才學會一開一闔往前蹦。",
  "inner": false,
  "emotion": "neutral",
  "voice": "Chinese (Mandarin)_Sincere_Adult",
  "file": "04_01_d222de.mp3",
  "secs": 5.58
 },
 {
  "shot": 4,
  "idx": 2,
  "role": "寶箱怪",
  "text": "我在村口翻倒了好幾次，最後是一個老爺爺把我扶正的。",
  "say": "我在村口翻倒了好幾次，最後是一個老爺爺把我扶正的。",
  "inner": false,
  "emotion": "happy",
  "voice": "Chinese (Mandarin)_Sincere_Adult",
  "file": "04_02_0e98c0.mp3",
  "secs": 4.0
 },
 {
  "shot": 4,
  "idx": 3,
  "role": "長老",
  "text": "咦，這不是我家倉庫那個箱子嗎？怎麼自己跑到村口來了。",
  "say": "咦，這不是我家倉庫那個箱子嗎？怎麼自己跑到村口來了。",
  "inner": false,
  "emotion": "surprised",
  "voice": "Larch_Mandarin_Dad",
  "file": "04_03_78f921.mp3",
  "secs": 4.64
 },
 {
  "shot": 4,
  "idx": 4,
  "role": "長老",
  "text": "……你醒了啊。從我爺爺的爺爺那時候就在用你，總算等到你醒了。",
  "say": "……你醒了啊。從我爺爺的爺爺那時候就在用你，總算等到你醒了。",
  "inner": false,
  "emotion": "happy",
  "voice": "Larch_Mandarin_Dad",
  "file": "04_04_18f230.mp3",
  "secs": 4.9
 },
 {
  "shot": 4,
  "idx": 5,
  "role": "寶箱怪",
  "text": "原來島上的人早就知道寶箱會動。沒有人怕我，市集老闆還叫我別擋在她攤子前面。",
  "say": "原來島上的人早就知道寶箱會動。沒有人怕我，市集老闆還叫我別擋在她攤子前面。",
  "inner": false,
  "emotion": "happy",
  "voice": "Chinese (Mandarin)_Sincere_Adult",
  "file": "04_05_937a37.mp3",
  "secs": 6.95
 },
 {
  "shot": 5,
  "idx": 0,
  "role": "寶箱怪",
  "text": "第三天，我開始覺得肚子餓。",
  "say": "第三天，我開始覺得肚子餓。",
  "inner": false,
  "emotion": "sad",
  "voice": "Chinese (Mandarin)_Sincere_Adult",
  "file": "05_00_f3da7b.mp3",
  "secs": 2.56
 },
 {
  "shot": 5,
  "idx": 1,
  "role": "寶箱怪",
  "text": "我在樹下張著蓋子發呆，一顆蘋果掉下來，剛好掉進箱子裡。",
  "say": "我在樹下張著蓋子發呆，一顆蘋果掉下來，剛好掉進箱子裡。",
  "inner": false,
  "emotion": "surprised",
  "voice": "Chinese (Mandarin)_Sincere_Adult",
  "file": "05_01_ac306a.mp3",
  "secs": 4.97
 },
 {
  "shot": 5,
  "idx": 2,
  "role": "寶箱怪",
  "text": "我嚇了一跳，蓋子一闔。……很甜。",
  "say": "我嚇了一跳，蓋子一闔。……很甜。",
  "inner": false,
  "emotion": "happy",
  "voice": "Chinese (Mandarin)_Sincere_Adult",
  "file": "05_02_af54d3.mp3",
  "secs": 2.95
 },
 {
  "shot": 6,
  "idx": 0,
  "role": "寶箱怪",
  "text": "後來我把島上的寶箱一個一個找出來。每一個都是族人，每一個都在睡覺。",
  "say": "後來我把島上的寶箱一個一個找出來。每一個都是族人，每一個都在睡覺。",
  "inner": false,
  "emotion": "neutral",
  "voice": "Chinese (Mandarin)_Sincere_Adult",
  "file": "06_00_ed3695.mp3",
  "secs": 6.52
 },
 {
  "shot": 6,
  "idx": 1,
  "role": "寶箱怪",
  "text": "我每天去敲，一個敲三下。叫不醒，我就說一聲「明天再來」。",
  "say": "我每天去敲，一個敲三下。叫不醒，我就說一聲「明天再來」。",
  "inner": false,
  "emotion": "sad",
  "voice": "Chinese (Mandarin)_Sincere_Adult",
  "file": "06_01_3bb218.mp3",
  "secs": 6.62
 },
 {
  "shot": 6,
  "idx": 2,
  "role": "寶箱怪",
  "text": "白天在村口曬太陽，晚上到海邊看海。就這樣過了一整個夏天。",
  "say": "白天在村口曬太陽，晚上到海邊看海。就這樣過了一整個夏天。",
  "inner": false,
  "emotion": "sad",
  "voice": "Chinese (Mandarin)_Sincere_Adult",
  "file": "06_02_7818c1.mp3",
  "secs": 7.31
 },
 {
  "shot": 7,
  "idx": 0,
  "role": "寶箱怪",
  "text": "今天早上，我在村口曬太陽，看到岸邊停了一艘沒看過的船。",
  "say": "今天早上，我在村口曬太陽，看到岸邊停了一艘沒看過的船。",
  "inner": false,
  "emotion": "surprised",
  "voice": "Chinese (Mandarin)_Sincere_Adult",
  "file": "07_00_f9a67b.mp3",
  "secs": 4.86
 },
 {
  "shot": 7,
  "idx": 1,
  "role": "少年獵人",
  "text": "這座島寶箱超多，隨便撬都有錢。",
  "say": "這座島寶箱超多，隨便撬都有錢。",
