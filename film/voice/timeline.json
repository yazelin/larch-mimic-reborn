  "secs": 3.02
 },
 {
  "shot": 7,
  "idx": 2,
  "role": "少女獵人",
  "text": "Pulut，聞一下，哪一箱有金幣？",
  "say": "Pulut，聞一下，哪一箱有金幣？",
